# CyberTrust KSA — Docker environment example.
# Copy to the repo-root .env and replace every placeholder. NEVER commit the real .env.
#   cp deployment/docker/env.example .env
#
# Placeholders only — no real secrets, passwords, or API keys here.

# ---- Django core ----
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=1saudicyber.com,www.1saudicyber.com
CSRF_TRUSTED_ORIGINS=https://1saudicyber.com,https://www.1saudicyber.com
DJANGO_SETTINGS_MODULE=cybertrust_ksa.settings

# ---- PostgreSQL (consumed by both the db and web services) ----
# Setting POSTGRES_DB switches the app from SQLite to PostgreSQL automatically.
POSTGRES_DB=cybertrust
POSTGRES_USER=cybertrust
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DB_CONN_MAX_AGE=60

# ---- Web port mapping (host:container) ----
WEB_PORT=8000

# ---- Advisory AI (optional; analysis is advisory only and not required) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Data sovereignty (PDPL / NCA). Evidence text leaves the Kingdom ONLY when this is
# 'external'. Keep 'disabled' unless you have explicit approval to use an external LLM.
AI_DATA_RESIDENCY_MODE=disabled

# ---- Payments ----
# 'manual' (default; admin confirms payments) or 'moyasar' (add keys below when agreed).
PAYMENT_PROVIDER=manual
# MOYASAR_PUBLISHABLE_KEY=
# MOYASAR_SECRET_KEY=
# MOYASAR_WEBHOOK_SECRET=

# ---- Initial admin (used once by create_admin.py; do not commit real values) ----
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---- Celery / Redis (optional async; not required for the core workflow) ----
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---- Email (defaults to console backend if unset) ----
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@1saudicyber.com
# SITE_URL=https://1saudicyber.com

# ---- Static / media (defaults are fine inside the image) ----
# STATIC_ROOT and MEDIA_ROOT default to /app/staticfiles and /app/media.
