# CyberTrust KSA — Docker environment example.
# Copy to the repo-root .env and replace every placeholder. NEVER commit the real .env.
#   cp deployment/docker/env.example .env
#
# Placeholders only — no real secrets, passwords, or API keys here.

# ---- Django core ----
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
# Public domains + the container loopback (127.0.0.1/localhost) — the loopback is REQUIRED
# so the in-container Docker healthcheck (http://127.0.0.1:8000/healthz/) is not rejected
# as a DisallowedHost. External requests still only reach cyber-5.com via the reverse proxy.
ALLOWED_HOSTS=cyber-5.com,www.cyber-5.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://cyber-5.com,https://www.cyber-5.com
DJANGO_SETTINGS_MODULE=cybertrust_ksa.settings

# ---- PostgreSQL (consumed by both the db and web services) ----
# Setting POSTGRES_DB switches the app from SQLite to PostgreSQL automatically.
POSTGRES_DB=cybertrust
POSTGRES_USER=cybertrust
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DB_CONN_MAX_AGE=60

# ---- Web port mapping (host:container) ----
WEB_PORT=8000

# ---- Advisory AI (optional; analysis is advisory only and not required) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Data sovereignty (PDPL / NCA). Evidence text leaves the Kingdom ONLY when this is
# 'external'. Keep 'disabled' unless you have explicit approval to use an external LLM.
AI_DATA_RESIDENCY_MODE=disabled

# ---- Payments ----
# 'manual' (default; admin confirms payments) or 'moyasar' (add keys below when agreed).
PAYMENT_PROVIDER=manual
# MOYASAR_PUBLISHABLE_KEY=
# MOYASAR_SECRET_KEY=
# MOYASAR_WEBHOOK_SECRET=

# ---- Initial admin (used once by create_admin.py; do not commit real values) ----
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---- Celery / Redis (optional async; not required for the core workflow) ----
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---- Email (defaults to console backend if unset) ----
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@cyber-5.com
# SITE_URL=https://cyber-5.com
# PUBLIC_BASE_URL=https://cyber-5.com   # defaults to SITE_URL if unset

# ---- Static / media (defaults are fine inside the image) ----
# STATIC_ROOT and MEDIA_ROOT default to /app/staticfiles and /app/media.

# ============================================================================
# DD-fix additions — production ops / performance / security
# ============================================================================

# ---- Redis (broker + Django cache: login throttle, hot-read caching) --------
# Set REDIS_URL to enable the Redis cache backend (else safe local-memory).
# REDIS_URL=redis://redis:6379/1
# CELERY_BROKER_URL=redis://redis:6379/0

# ---- Async evidence processing (OCR/AI/PDF off the request thread) ----------
# STRONGLY RECOMMENDED FOR PRODUCTION: keeps heavy OCR/AI/report work OFF the
# gunicorn request thread (otherwise a few concurrent uploads exhaust the workers).
# Requires the `worker` service (docker-compose) to be running.
EVIDENCE_ASYNC_ENABLED=True

# ---- Payments: go-live -------------------------------------------------------
# To collect real payments: set MOYASAR_MODE=live AND a pk_live_ publishable key.
# MOYASAR_MODE=sandbox            # sandbox | live
# MOYASAR_PUBLISHABLE_KEY=pk_test_xxx   # pk_live_xxx in live mode
# MOYASAR_SECRET_KEY=sk_...             # server-side only, never exposed
# MOYASAR_WEBHOOK_SECRET=...            # shared token for webhook verification

# ---- Object storage for evidence (horizontal scaling; in-Kingdom for PDPL) ---
# Setting AWS_STORAGE_BUCKET_NAME switches evidence media to S3.
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=me-central-1        # KSA region (data residency)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=                   # for S3-compatible in-Kingdom providers

# ---- Error tracking / logging -----------------------------------------------
# SENTRY_DSN=
# SENTRY_ENV=production
# SENTRY_TRACES_RATE=0.1
# LOG_LEVEL=INFO

# ---- Session / auth hardening -----------------------------------------------
# SESSION_COOKIE_AGE=43200               # 12h
# LOGIN_FAILURE_LIMIT=8
# LOGIN_FAILURE_WINDOW=900               # 15 min
# RECOMMENDED FOR PRODUCTION: require MFA for every staff/admin account.
ENFORCE_ADMIN_MFA=True

# ---- Backups ----------------------------------------------------------------
# BACKUP_DIR=/app/backups                # schedule: manage.py backup_db --keep-days 14
