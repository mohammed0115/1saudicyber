# CyberTrust KSA Environment Configuration
# Copy this file to .env and fill in your values

# Django Settings
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost:5432/cybertrust_ksa

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Celery (for async AI processing)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# File Upload — evidence files may be up to 50 MB (SRS FR-005.2).
# The effective limit is settings.MAX_EVIDENCE_FILE_SIZE (50 MB); this var is informational.
MAX_UPLOAD_SIZE=52428800
MEDIA_ROOT=media/

# Security (Production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
