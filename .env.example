# ============================================================================
# 1SaudiCyber — Environment configuration (DEV template)
# Copy to .env and fill in real values.  NEVER commit a real .env.
#
# >>> SECRETS: treat OPENAI_API_KEY / EMAIL_HOST_PASSWORD / DJANGO_SECRET_KEY as
#     live secrets. Keep them ONLY in .env (git-ignored) or a secrets manager
#     (AWS Secrets Manager / Vault). Rotate immediately if ever exposed in a
#     backup, log, or shared file.
#
# >>> For the FULL PRODUCTION template (Postgres, Redis, Celery, S3, Sentry,
#     MFA, async, Moyasar-live) use:  deployment/docker/env.example
# ============================================================================

# ---- Django core ----
DJANGO_SECRET_KEY=dev-only-change-me
DEBUG=True                     # MUST be False in production
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Dev uses SQLite automatically. For Postgres, settings.py reads POSTGRES_* (NOT DATABASE_URL):
# POSTGRES_DB=cybertrust
# POSTGRES_USER=cybertrust
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ---- AI (advisory, fail-closed on data residency) ----
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
AI_DATA_RESIDENCY_MODE=disabled   # 'external' to allow external LLM calls (sends text out of KSA)

# ---- Celery / Redis (async evidence OCR/AI/PDF) ----
# REDIS_URL=redis://localhost:6379/0
# EVIDENCE_ASYNC_ENABLED=True       # recommended in prod (needs the worker running)

# ---- Email (OTP / verification delivery) ----
# Default backend is console (prints, does not deliver). Set SMTP for real delivery:
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=no-reply@cyber-5.com
# EMAIL_HOST_PASSWORD=change-me

# ---- Security (production) ----
# ENFORCE_ADMIN_MFA=True
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
